#!/usr/bin/env bash
# The push-time gate: lint --gate (~2m20s). It used to be a "push-time ritual"
# — a sentence asking a human to remember, and the day it stayed a memory is
# the day #636's and #612's findings rode into history on green suites alone
# (2026-11-09/10). Whatever a machine can absorb, a machine absorbed. This
# hook self-installs with the same core.hooksPath mechanism as pre-commit.
# Escape hatch: git push --no-verify.
set -e
cd "$(git rev-parse --show-toplevel)"
# not driven by push machinery (manual invocation), or nothing to update
[ -t 0 ] && exit 0
UPDATES=$(cat)
[ -z "$UPDATES" ] && exit 0
# same arming rule as pre-commit: a fresh clone cannot gate, skip loudly
if [ ! -f build/CMakeCache.txt ]; then
    echo "pre-push: no configured build/ here — gate skipped (run cmake -S . -B build to arm it)" >&2
    exit 0
fi
python3 scripts/lint.py build --gate > /tmp/qimgv-hook-lint.log 2>&1 || {
    echo "pre-push: lint gate red:" >&2
    tail -20 /tmp/qimgv-hook-lint.log >&2
    echo "(fix it, or git push --no-verify if you truly mean it)" >&2
    exit 1
}
echo "pre-push: lint baseline holds" >&2
